# Khalti Payment Configuration
# Get your keys from https://khalti.com/merchant/apps/

# Environment: "sandbox" for testing, "production" for live
KHALTI_ENV=sandbox

# Secret key (server-side only - never expose this)
KHALTI_SECRET_KEY=your_khalti_secret_key_here

# Public key (can be used on frontend if needed)
KHALTI_PUBLIC_KEY=your_khalti_public_key_here

# Optional: Webhook secret for validating webhook signatures
KHALTI_WEBHOOK_SECRET=your_webhook_secret_here

# Note: For testing, use sandbox credentials from Khalti dashboard
# Test credentials:
# - Mobile Number: 9800000000 to 9800000005
# - MPIN: 1111
# - OTP: 987654

# Exchange Rate (NPR per 1 USD) - update periodically
# This is used to convert USD prices to NPR
# Default: 133 (update based on current rates)
